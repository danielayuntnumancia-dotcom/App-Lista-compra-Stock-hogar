rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShoppingItem(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'quantity', 'checked', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string && data.name.size() <= 100 &&
             data.quantity is number &&
             data.checked is bool &&
             data.createdAt is string &&
             data.updatedAt is string &&
             (data.keys().hasAll(['category']) ? (data.category is string && data.category.size() <= 50) : true);
    }

    function isValidInventoryItem(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'quantity', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string && data.name.size() <= 100 &&
             data.quantity is number &&
             data.createdAt is string &&
             data.updatedAt is string &&
             (data.keys().hasAll(['category']) ? (data.category is string && data.category.size() <= 50) : true) &&
             (data.keys().hasAll(['minStock']) ? data.minStock is number : true);
    }

    function isValidReceipt(data, userId) {
      return data.keys().hasAll(['userId', 'storeName', 'totalItems', 'totalPrice', 'date', 'createdAt']) &&
             data.userId == userId &&
             data.storeName is string && data.storeName.size() <= 100 &&
             data.totalItems is number &&
             data.totalPrice is number &&
             data.date is string &&
             data.createdAt is string;
    }

    match /users/{userId}/shoppingList/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(itemId) &&
                       isValidShoppingItem(incoming(), userId) &&
                       incoming().keys().size() <= 7;
      allow update: if isOwner(userId) &&
                       isValidId(itemId) &&
                       isValidShoppingItem(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().size() <= 7;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/inventory/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(itemId) &&
                       isValidInventoryItem(incoming(), userId) &&
                       incoming().keys().size() <= 7;
      allow update: if isOwner(userId) &&
                       isValidId(itemId) &&
                       isValidInventoryItem(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().size() <= 7;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/history/{receiptId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(receiptId) &&
                       isValidReceipt(incoming(), userId) &&
                       incoming().keys().size() <= 6;
      allow delete: if isOwner(userId);
    }
  }
}
